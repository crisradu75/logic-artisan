#!/bin/sh
# CLA guard: refuse a push that targets the default branch directly, and a push
# that deletes a tag on the remote or moves a tag the remote already has.
#
# This replaces a 491-line PreToolUse hook that parsed the `git push` command
# STRING to guess its destination. That approach never converged: `git.exe`,
# `GIT.EXE`, `-C <dir>`, `--repo <name>`, `$VAR` lifting, and quoted spans each
# walked past it, costing five bypass-closing commits and two reverted
# redesigns. A `pre-push` hook is handed the resolved refspec by git itself,
# AFTER git's own argument parsing — so there is no command shape to get wrong,
# and no way to name the target branch that evades it. git itself skips the hook
# on `git push --no-verify`; the override below is the hook's own exception.
#
# It is also strictly broader: it fires for pushes this harness never sees at
# all — from a terminal, an IDE, or another tool.
#
# INSTALL (per clone; a plugin cannot install this for you):
#   cp "<plugin>/hooks/git/pre-push" .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# A branch DELETION arrives with an all-zero local sha and the same remote ref,
# so deleting the default branch is refused by the same case below.
#
# Tags: a consumer that fetched a tag has that tree, so a published tag is not
# rewritten in place; a fix ships as a new tag. For a ref under `refs/tags/`:
#   local sha all zeros                      a delete         refused
#   remote sha all zeros                     a new tag        allowed
#   remote sha set and different from local a move           refused
#   remote sha equal to local                nothing changes  allowed
# Any tag name, lightweight or annotated (an annotated tag's sha is its tag
# object, so re-creating one on the same commit is a move too).
#
# Overrides, each for a genuine emergency and each lifting only its own refusal:
#   ALLOW_PUSH_TO_MAIN=1 git push ...   a push to or delete of the default branch
#   ALLOW_TAG_REWRITE=1 git push ...    a tag delete or move

# An all-zero sha (40 digits for SHA-1, 64 for SHA-256) names no object.
is_zero() {
    case $1 in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

# The remote's own default branch is refused too, so a repo whose default is
# `develop` or `trunk` is guarded. git passes the remote's name as $1 (a URL when
# the push names one, which has no remote-tracking HEAD); without it, or with no
# `refs/remotes/<remote>/HEAD`, only main and master are refused.
default_ref=""
remote_name=${1:-origin}
# A push that names a URL hands the hook that URL as $1 and $2. When $1 is not a
# configured remote, use the remote whose URL equals $2, so a URL push is checked
# against the same default branch. An exact string match only; with no match the
# fallback below stays: only main and master are refused. When two remotes share
# one URL, the first in `git remote` order (by name) wins, because the loop breaks
# on the first match.
if ! git remote 2>/dev/null | grep -qxF -- "$remote_name"; then
    url=${2:-$remote_name}
    for candidate in $(git remote 2>/dev/null); do
        # Every fetch URL and every push URL: git passes the push URL it will use.
        if { git remote get-url --all "$candidate"; git remote get-url --push --all "$candidate"; } 2>/dev/null | grep -qxF -- "$url"; then
            remote_name=$candidate
            break
        fi
    done
fi
if head=$(git symbolic-ref --quiet "refs/remotes/$remote_name/HEAD" 2>/dev/null); then
    default_ref="refs/heads/${head#refs/remotes/"$remote_name"/}"
fi

status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
    [ -n "$remote_ref" ] || continue
    target="$remote_ref"
    if [ -n "$default_ref" ] && [ "$remote_ref" = "$default_ref" ]; then
        target=refs/heads/main  # route the remote's default through the refusal below
    fi
    case "$target" in
        refs/heads/main|refs/heads/master)
            [ "${ALLOW_PUSH_TO_MAIN:-}" = "1" ] && continue
            branch=${remote_ref#refs/heads/}
            echo "cla: refusing to push directly to '$branch'." >&2
            echo "     Branch and open a PR instead:" >&2
            echo "       git checkout -b feature/<name> && git push -u origin HEAD" >&2
            echo "       gh pr create" >&2
            echo "     Override for a genuine emergency: ALLOW_PUSH_TO_MAIN=1 git push ..." >&2
            status=1
            ;;
        refs/tags/*)
            [ "${ALLOW_TAG_REWRITE:-}" = "1" ] && continue
            tag=${remote_ref#refs/tags/}
            if is_zero "$local_sha"; then
                echo "cla: refusing to delete tag '$tag' on the remote." >&2
            elif ! is_zero "$remote_sha" && [ "$remote_sha" != "$local_sha" ]; then
                echo "cla: refusing to move tag '$tag', which the remote already has." >&2
            else
                continue
            fi
            echo "     Anyone who fetched it keeps the old tree; publish a new tag instead." >&2
            echo "     Override for a genuine emergency: ALLOW_TAG_REWRITE=1 git push ..." >&2
            status=1
            ;;
    esac
done

exit $status
