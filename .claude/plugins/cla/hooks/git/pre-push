#!/bin/sh
# CLA guard: refuse a push that targets the default branch directly.
#
# This replaces a 491-line PreToolUse hook that parsed the `git push` command
# STRING to guess its destination. That approach never converged: `git.exe`,
# `GIT.EXE`, `-C <dir>`, `--repo <name>`, `$VAR` lifting, and quoted spans each
# walked past it, costing five bypass-closing commits and two reverted
# redesigns. A `pre-push` hook is handed the resolved refspec by git itself,
# AFTER git's own argument parsing — so there is no command shape to get wrong,
# and no way to spell a push that evades it.
#
# It is also strictly broader: it fires for pushes this harness never sees at
# all — from a terminal, an IDE, or another tool.
#
# INSTALL (per clone; a plugin cannot install this for you):
#   cp "<plugin>/hooks/git/pre-push" .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# A branch DELETION arrives with an all-zero local sha and the same remote ref,
# so deleting the default branch is refused by the same case below.
#
# Override for a genuine emergency:
#   ALLOW_PUSH_TO_MAIN=1 git push ...

if [ "${ALLOW_PUSH_TO_MAIN:-}" = "1" ]; then
    exit 0
fi

status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ -n "$remote_ref" ] || continue
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            branch=${remote_ref#refs/heads/}
            echo "cla: refusing to push directly to '$branch'." >&2
            echo "     Branch and open a PR instead:" >&2
            echo "       git checkout -b feature/<name> && git push -u origin HEAD" >&2
            echo "       gh pr create" >&2
            echo "     Override for a genuine emergency: ALLOW_PUSH_TO_MAIN=1 git push ..." >&2
            status=1
            ;;
    esac
done

exit $status
