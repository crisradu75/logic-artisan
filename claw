#!/usr/bin/env bash
# claw — create a git worktree, THEN launch Claude Code already inside it.
#
# POSIX launcher (macOS / Linux / Git Bash). The native-Windows counterpart is
# `claw.cmd` in this same dir — keep the two in sync.
#
# Usage (from anywhere):  path/to/repo/claw <name> [extra claude args...]
#
# Why this exists, and why it is not just `cla` plus a skill call
# ---------------------------------------------------------------
# `guard-worktree-isolation.py` writes a presence heartbeat at SessionStart for
# any session whose cwd is the PRIMARY CLONE, so that a second session there
# cannot silently mutate the shared HEAD. That write happens before you can type
# anything — so a session that starts in the primary clone and only then runs
# `/cla:new-worktree` has ALREADY registered as a contender. When it migrates
# into the worktree the beat stops refreshing but is not removed, and a
# different session working legitimately in the primary clone is blocked from
# committing until the beat ages out (an hour).
#
# A session launched by this script has `git_dir != git_common_dir` from its
# very first instant, so `_primary_guard_dir()` returns None, NO heartbeat is
# ever written, and nobody is ever blocked by it. The problem is prevented
# rather than cleaned up after.
#
# `/cla:new-worktree` remains the right tool when you are already mid-session
# and only then realise you want isolation; this is for when you know up front.
#
# NOTE: like `cla`, this launches with --permission-mode auto, which bypasses
# Claude Code's normal per-action confirmation prompts. Intentional for this
# harness, but worth knowing.
#
# NOTE: dependencies are NOT installed and gitignored env files are NOT copied.
# Those commands are per-repo facts (they live in new-worktree's
# `references/project-context.md` overlay), so a portable launcher cannot know
# them — `npm ci` would be wrong for a Python or Rust consumer. Ask the launched
# session to finish the setup; running it from inside the worktree writes no
# heartbeat, so it costs nothing.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
plugin_dir="$here/.claude/plugins/cla"
worktree_script="$plugin_dir/skills/new-worktree/scripts/manual_worktree.py"

usage() {
  echo "usage: claw <name> [extra claude args...]" >&2
  echo "  <name>  worktree name; becomes .claude/worktrees/<name> on branch worktree-<name>" >&2
}

# A missing name must NOT fall through to launching in the primary clone —
# that is precisely the situation this script exists to avoid.
if [ "$#" -eq 0 ]; then
  echo "claw: a worktree name is required." >&2
  usage
  exit 1
fi

# `claw --help` names a flag where a name belongs. A worktree name can never
# start with a dash, so treat this as a missing name rather than passing it on.
case "$1" in
  -*)
    echo "claw: expected a worktree name, got the flag '$1'." >&2
    usage
    exit 1
    ;;
esac

name="$1"
shift

if [ ! -d "$plugin_dir" ]; then
  echo "claw: plugin directory not found: $plugin_dir" >&2
  echo "claw: expected .claude/plugins/cla next to this script -- check it exists (incomplete checkout, or invoked through a symlink?)" >&2
  exit 1
fi

if [ ! -f "$worktree_script" ]; then
  echo "claw: worktree script not found: $worktree_script" >&2
  exit 1
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "claw: 'claude' (the Claude Code CLI) was not found on PATH." >&2
  echo "claw: install it, or make sure it's on PATH, then re-run this script." >&2
  exit 127
fi

# Interpreter probe: each candidate is RUN before being accepted, because on
# Windows `python3` commonly resolves to the Store alias stub in WindowsApps,
# which prints nothing, exits non-zero, and would surface here as an
# unexplained "worktree creation failed".
#
# This comment used to say "Unlike the guard hooks' version" — the hooks have
# run their candidates for some time now, and in fact went FURTHER than this
# did: they assert the interpreter's VERSION via stdout, where this settled for
# `-c "import sys"`, a bare liveness check that passes on Python 2.7 and on any
# wrapper that swallows `-c` and exits 0. The hooks' own
# `test_probe_rejects_an_interpreter_that_exits_zero_for_everything` exists to
# reject exactly that weaker form, so the launcher was left holding the hole the
# hooks had closed. Matched to the stronger form here; the candidate ORDER is
# what both sides pin, and `hooks.json`'s `_comment` says so.
PYEXE=""
for _candidate in python3 py python; do
  _path="$(command -v "$_candidate" 2>/dev/null)" || continue
  if [ "$("$_path" -c "import sys; print(1 if sys.version_info >= (3,8) else 0)" 2>/dev/null)" = 1 ]; then
    PYEXE="$_path"
    break
  fi
done
if [ -z "$PYEXE" ]; then
  echo "claw: no working python interpreter found on PATH (tried python3, py, python)." >&2
  echo "claw: note a non-functional 'python3' shim (e.g. the Windows Store alias) is skipped, not used." >&2
  exit 127
fi

# Creation is delegated, never reimplemented here: manual_worktree.py already
# resolves the base branch, validates the name, refuses a duplicate branch with
# an actionable message, and carries the Windows path-casing fallback. Its
# --print-path mode puts the bare path on stdout and any error on stderr, so
# there is no JSON to parse in shell.
worktree_path="$("$PYEXE" "$worktree_script" --repo "$here" --name "$name" --print-path)" || {
  echo "claw: worktree creation failed; not launching." >&2
  exit 1
}

if [ -z "$worktree_path" ] || [ ! -d "$worktree_path" ]; then
  echo "claw: worktree script reported success but '$worktree_path' is not a directory; not launching." >&2
  exit 1
fi

# The launched session must use the WORKTREE's own copy of the plugin, not the
# primary clone's — loading the plugin from outside the worktree would put
# hook-relative paths back in the clone this script is trying to stay out of.
worktree_plugin_dir="$worktree_path/.claude/plugins/cla"
if [ ! -d "$worktree_plugin_dir" ]; then
  echo "claw: the new worktree has no .claude/plugins/cla ($worktree_plugin_dir)." >&2
  echo "claw: is the plugin committed on the base branch? Not launching." >&2
  exit 1
fi

# `cd` before announcing anything, so a banner can never name a worktree the
# session is not actually in. `set -e` aborts on a failed cd; the explicit
# message is for the user, not for control flow.
cd "$worktree_path" || {
  echo "claw: could not enter $worktree_path; not launching." >&2
  exit 1
}

# Assert the ONE property this launcher promises, rather than assuming the cd
# implied it: a linked worktree has git_dir != git_common_dir. Equal means the
# primary clone, where launching would write the presence heartbeat this script
# exists to avoid — the exact failure, so it is checked rather than trusted.
_git_dir="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
if [ -z "$_git_dir" ]; then
  echo "claw: could not resolve the git dir after entering the worktree; not launching." >&2
  exit 1
fi
# --git-common-dir can come back relative; resolve both before comparing.
_git_dir="$(cd "$_git_dir" 2>/dev/null && pwd)" || _git_dir=""
_common_dir="$(cd "$_common_dir" 2>/dev/null && pwd)" || _common_dir=""
if [ -n "$_git_dir" ] && [ "$_git_dir" = "$_common_dir" ]; then
  echo "claw: cwd resolves to the PRIMARY CLONE, not a linked worktree; not launching." >&2
  echo "claw: launching here would write the presence heartbeat this script exists to avoid." >&2
  exit 1
fi

echo "claw: worktree ready at $worktree_path" >&2
echo "claw: dependencies are NOT installed and env files are NOT copied." >&2
echo "claw: run /cla:new-worktree in the session to finish setup (it detects the existing worktree and runs setup only)." >&2
echo "+ claude --plugin-dir \"$worktree_plugin_dir\" --permission-mode auto --model sonnet --effort medium $*" >&2
exec claude --plugin-dir "$worktree_plugin_dir" --permission-mode auto --model sonnet --effort medium "$@"
